{
  "$schema": "https://mintlify.com/docs.json",
  "name": "PokPok",
  "theme": "mint",
  "logo": {
    "light": "/logo/pokpok-logo-light.svg",
    "dark": "/logo/pokpok-logo-animated.svg",
    "href": "https://pokpok.ai"
  },
  "favicon": "/logo/pokpok-icon.svg",
  "colors": {
    "primary": "#0A3B44",
    "light": "#F5F900",
    "dark": "#0A3B44"
  },
  "background": {
    "color": {
      "light": "#E8E0D1",
      "dark": "#0A3B44"
    }
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Instrument Serif",
      "weight": 400
    },
    "body": {
      "family": "JetBrains Mono"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://pokpok.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "how-it-works",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/hi-vs-ai",
              "concepts/brand-markers",
              "concepts/scoring"
            ]
          },
          {
            "group": "Analyse",
            "pages": [
              "analyse/overview",
              "analyse/pokpok-index",
              "analyse/category-perception",
              "analyse/customer-experience",
              "analyse/ai-visibility-tracker-methodology"
            ]
          },
          {
            "group": "Diagnose",
            "pages": [
              "diagnose/overview",
              "diagnose/xray",
              "diagnose/brand-perception",
              "diagnose/brand-alignment",
              "diagnose/customer-experience"
            ]
          },
          {
            "group": "Treat",
            "pages": [
              "treat/overview"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/plans-and-pricing",
              "account/credits",
              "account/managing-reports"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Claude MCP",
            "pages": [
              "integrations/mcp-overview",
              "integrations/mcp-setup",
              "integrations/mcp-queries"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/privacy"
            ]
          }
        ]
      }
    ]
  },
  "thumbnails": {
    "preset": "classic",
    "appearance": "dark",
    "surface": "neutral",
    "fonts": {
      "family": "Instrument Serif",
      "source": "/fonts/InstrumentSerif-Regular.ttf",
      "format": "ttf"
    },
    "eyebrow": {
      "source": "group",
      "style": "bar",
      "color": "#F5F900"
    }
  }
}
